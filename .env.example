# ==========================================================
#  إعدادات Supabase (اختيارية)
# ==========================================================
# اترك هذين المتغيرين فارغين ليعمل التطبيق بالتخزين المحلي
# داخل المتصفح (IndexedDB) — مناسب للتجربة فقط.
#
# لتفعيل قاعدة البيانات السحابية:
#   1. أنشئ مشروعاً مجانياً على https://supabase.com
#   2. انسخ القيمتين من: Project Settings → API
#   3. انسخ هذا الملف إلى .env.local وضع القيم فيه
#   4. شغّل ملف supabase/schema.sql في محرر SQL داخل Supabase
#
# الدليل الكامل بالعربية: docs/SETUP-AR.md
# ==========================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==========================================================
#  كلمة مرور الوضع التجريبي (بدون Supabase فقط)
# ==========================================================
# تُستخدم للدخول إلى /admin ما دامت مفاتيح Supabase فارغة.
# القيمة الافتراضية إن تُركت فارغة: admin1234
# غير آمنة للنشر العام — بمجرد تفعيل Supabase تُستخدم مصادقة
# Supabase الحقيقية ويُتجاهل هذا المتغير تماماً.
NEXT_PUBLIC_ADMIN_DEMO_PASSWORD=

# ملاحظة أمنية مهمة:
# لا تضع مفتاح service_role هنا إطلاقاً. المفتاح الوحيد المسموح
# باستخدامه في الواجهة هو anon، وهو محمي بقواعد RLS في schema.sql
